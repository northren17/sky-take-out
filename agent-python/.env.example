# Required by ASR and TTS.
DASHSCOPE_API_KEY=
# Optional. Leave empty to use the account's default workspace.
DASHSCOPE_WORKSPACE_ID=
# Required by the customer-service Agent.
DEEPSEEK_API_KEY=
# Optional. Enables public web search only when configured.
ZHIPU_API_KEY=
# Internal Docker service URL, for example http://sky-server:8080
AGENT_JAVA_INTERNAL_URL=
# Distinct directional HMAC-SHA-256 secrets (at least 32 bytes); never use in frontend vars.
AGENT_PYTHON_HMAC_SECRET=
AGENT_JAVA_HMAC_SECRET=
# Comma-separated browser origins allowed to open the voice WebSocket.
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAG_MAX_COSINE_DISTANCE=
RAG_CALIBRATION_VERSION=unvalidated
RAG_CALIBRATED_INDEX_VERSION=
