# Copy to .env in this directory and fill only on the deployment host.
# Do not commit the populated .env file.
DOMAIN=

SKY_MYSQL_ROOT_PASSWORD=
SKY_DATASOURCE_DATABASE=sky_take_out
SKY_DATASOURCE_USERNAME=
SKY_DATASOURCE_PASSWORD=

SKY_REDIS_PASSWORD=
SKY_RABBITMQ_USERNAME=
SKY_RABBITMQ_PASSWORD=
SKY_RABBITMQ_VIRTUAL_HOST=/

# Use separate random secrets for the two directions.
# Python -> Java: same value in SKY_AGENT_PYTHON_HMAC_SECRET and the
# Java container receives it as SKY_AGENT_PYTHON_HMAC_SECRET.
# Java -> Python: same value in SKY_AGENT_JAVA_HMAC_SECRET and the
# Agent container receives it as AGENT_JAVA_HMAC_SECRET.
SKY_AGENT_PYTHON_HMAC_SECRET=
SKY_AGENT_JAVA_HMAC_SECRET=

APP_JWT_ADMIN_SECRET_KEY=
APP_JWT_USER_SECRET_KEY=
APP_BAIDU_AK=

# Required when the corresponding business integration is enabled.
SKY_ALIOSS_ENDPOINT=
SKY_ALIOSS_ACCESS_KEY_ID=
SKY_ALIOSS_ACCESS_KEY_SECRET=
SKY_ALIOSS_BUCKET_NAME=
SKY_WECHAT_APPID=
SKY_WECHAT_SECRET=
SKY_WECHAT_MCHID=
SKY_WECHAT_MCH_SERIAL_NO=
SKY_WECHAT_API_V3_KEY=
SKY_WECHAT_NOTIFY_URL=
SKY_WECHAT_REFUND_NOTIFY_URL=

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# Keep blank until the deployed policy index has been calibrated and reviewed.
RAG_MAX_COSINE_DISTANCE=
RAG_CALIBRATION_VERSION=unvalidated
RAG_CALIBRATED_INDEX_VERSION=
