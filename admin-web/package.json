{
  "name": "sky-admin-vue3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "serve": "vite",
    "build": "tsc --noEmit --project tsconfig.typecheck.json && vite build",
